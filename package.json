{
  "name": "viewer-bim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/typescript/bin/tsc -p worker",
    "typecheck:worker": "node node_modules/typescript/bin/tsc -p worker",
    "test": "node --test --test-timeout=30000 \"tests/**/*.test.ts\"",
    "sample": "node scripts/make-sample.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.2"
  }
}
